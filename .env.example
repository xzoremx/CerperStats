# ========================================
# CONFIGURACIÓN DEL BACKEND
# ========================================
# IMPORTANTE: Copia este archivo a ".env" y configura las URLs reales antes de hacer build
#
# Para desarrollo local:
#   CERPER_PROXY_URL=http://localhost:4000
#
# Para producción/distribución:
#   CERPER_PROXY_URL=https://tu-servidor.com
#   CERPER_PROXY_TOKEN=tu_token_secreto
#
# ========================================

# URL del servidor backend/proxy (REQUERIDO)
# Esta URL se embebe en el ejecutable para que funcione en otras PCs
CERPER_PROXY_URL=http://localhost:4000

# URL alternativa para evaluaciones (OPCIONAL)
# Si no se especifica, se usa CERPER_PROXY_URL
CERPER_EVAL_URL=

# Token de autenticación para el proxy (OPCIONAL pero RECOMENDADO)
# Protege el acceso al backend
CERPER_PROXY_TOKEN=
