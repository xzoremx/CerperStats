{
  "app": {
    "name": "CerperStats",
    "version": "1.0.0",
    "description": "Sistema de evaluación estadística para laboratorios CERPER",
    "author": "Renato Huamani",
    "theme": "dark-glass",
    "build": {
      "mode": "offline",
      "platform": "electron"
    }
  },
  "database": {
    "path": "./database/cerperstats.db"
  },
  "labs": "dynamic",
  "paths": {
    "assets": "./assets/",
    "modules": "./modules/",
    "input_data": "./input_data/",
    "results": "./results/",
    "runtime": "./run_time/"
  },
  "ui": {
    "font": "Segoe UI",
    "background": "radial-gradient(circle at top, #001f2f, #000)",
    "accent": "#00ffff"
  }
}

