{
  "name": "cerperstats",
  "version": "0.1.0",
  "description": "App estadística de CERPER - prototipo inicial",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "vite",
    "build": "vite build && powershell -Command \"Copy-Item -Path 'assets' -Destination 'dist-react\\' -Recurse -Force\"",
    "test": "jest",
    "prebuild": "node scripts/copy-chrome.js && node scripts/embed-config.js",
    "pack": "npm run prebuild && electron-builder --dir",
    "dist": "npm run prebuild && electron-builder",
    "dist:win": "npm run prebuild && electron-builder --win",
    "postinstall": "electron-builder install-app-deps"
  },
  "author": "Renato Huamani",
  "license": "MIT",
  "devDependencies": {
    "autoprefixer": "^10.4.22",
    "electron": "^32.0.0",
    "electron-builder": "^24.13.3",
    "jest": "^30.2.0",
    "postcss": "^8.5.6",
    "tailwindcss": "https://registry.npmjs.org/tailwindcss/-/tailwindcss-3.4.14.tgz",
    "typescript": "^5.9.3",
    "vite": "^7.3.0"
  },
  "dependencies": {
    "axios": "^1.13.2",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "jsonwebtoken": "^9.0.2",
    "lucide": "^0.545.0",
    "pagedjs": "^0.4.3",
    "pdf-lib": "^1.17.1",
    "pg": "^8.16.3",
    "puppeteer": "^23.11.1"
  }
}
